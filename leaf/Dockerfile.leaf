
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends expect \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @rivolink/leaf \
 && npm cache clean --force

COPY leaf-keys.exp /usr/local/bin/leaf-keys.exp
ENTRYPOINT ["expect", "-f", "/usr/local/bin/leaf-keys.exp", "--"]

